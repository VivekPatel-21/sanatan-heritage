{
  "layout": "layout.njk",
  "permalink": "reading-library.html",
  "title": "Your reading library · Sanatan Heritage",
  "description": "Return to saved stories, resume a chapter and take your reading library to another browser.",
  "bodyClass": "references-page library-page",
  "ogType": "website",
  "ogImage": "og.png",
  "ogImageAlt": "Sanatan Heritage — Stories, Wisdom, Traditions",
  "sourceLink": "sources.html#stories",
