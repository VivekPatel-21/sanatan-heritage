<header class="site-header" lang="en" data-pagefind-ignore>
<a class="brand brand-image" href="/index.html" aria-label="Sanatan Heritage home">{% include "brand-logo.njk" %}</a>
<div class="header-actions"><button class="theme-toggle" type="button" aria-label="Dark mode — Switch to dark theme">Dark mode</button><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu <span aria-hidden="true">☰</span></button></div>
<nav id="site-nav" class="site-nav" aria-label="Main navigation">
{% for group in navigation %}
<details class="nav-group"><summary>{{ group.label }}<span aria-hidden="true">⌄</span></summary><div class="nav-dropdown">{% for link in group.links %}<a href="{{ link.url }}"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.label }}</a>{% endfor %}</div></details>
{% endfor %}<a href="/search.html"{% if page.url == '/search.html' %} aria-current="page"{% endif %}>Search</a>
</nav></header>
