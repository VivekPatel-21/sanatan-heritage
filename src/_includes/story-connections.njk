{% for journey in journeys %}{% if journey.story.href == '/' + permalink %}
<section class="section story-connections" aria-labelledby="story-connections-title"><p class="eyebrow">FOLLOW THE CONNECTIONS</p><h2 id="story-connections-title">{{ journey.title }}</h2><div class="story-connection-links"><a href="{{ journey.deity.href }}"><span>The divine form</span>{{ journey.deity.title }} ↗</a><a href="{{ journey.scripture.href }}"><span>The text</span>{{ journey.scripture.title }} ↗</a><div><span>Words to know</span>{% for term in journey.terms %}<a href="{{ term.href }}">{{ term.title }} ↗</a>{% endfor %}</div>{% if journey.rishis %}<div class="rishi-connection"><span>{{ journey.rishiLabel }}</span>{% for rishi in journey.rishis %}<a href="{{ rishi.href }}">{{ rishi.title }} ↗</a>{% endfor %}</div>{% endif %}</div><a class="source-link" href="/explore.html#journey-{{ journey.id }}">Explore this connected journey →</a></section>
{% endif %}{% endfor %}
